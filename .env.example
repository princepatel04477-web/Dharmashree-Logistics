# Copy to `.env.local` and fill in.
#
# Where every form (quote, partner, truck attachment, message box) POSTs to.
# `/api/desk` is the site's own Cloudflare Pages Function (functions/api/desk.ts),
# which stores each submission in the D1 database the admin panel (/admin) reads.
# A Google Apps Script /exec URL still works here (apps-script/README.md).
# `next.config.ts` is `output: "export"`, so NEXT_PUBLIC_* is inlined at build
# time: set this in the Cloudflare Pages environment variables *before* the
# build, or the exported bundle ships without it and every submission reports
# "Unconfigured" instead of reaching the desk.
NEXT_PUBLIC_QUOTE_ENDPOINT="/api/desk"

# The client's tracking backend (LR lookup + SMS one-time code) — see
# docs/backend-integration.md. Read in src/lib/backend/config.ts.
#   unset / empty : OFF. /track keeps the WhatsApp / email / phone handoff.
#   mock          : local QA only. A simulator answers (LR DSL12345, code 123456).
#                   A production build ignores it and stays OFF, so the simulator
#                   can never reach a customer.
#   https://…     : LIVE. The API base, no trailing slash needed. The browser calls
#                   it directly, so the API must allow this site's origins (CORS).
# Inlined at build time (`output: "export"`): after setting or changing it, rebuild
# — on Cloudflare Pages, set it under Settings > Environment variables, then redeploy.
# It is public by design: never put a secret key here.
NEXT_PUBLIC_DSL_API_BASE=

# Prototype hand-over only: with =1 (and NEXT_PUBLIC_DSL_API_BASE=direct) the sample
# bookings DEMO - 1001 (mobile 98765 43210) and DEMO - 1002 (98123 45670) answer on
# /track, labelled "Sample booking". Leave unset for production.
NEXT_PUBLIC_TRACK_DEMO=
