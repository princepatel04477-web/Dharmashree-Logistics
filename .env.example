# Copy to `.env.local` and fill in — see apps-script/README.md for the setup.
#
# The Google Apps Script Web App URL that /quote POSTs to.
# `next.config.ts` is `output: "export"`, so NEXT_PUBLIC_* is inlined at build
# time: set this in the Cloudflare Pages environment variables *before* the
# build, or the exported bundle ships without it and every submission reports
# "Unconfigured" instead of reaching the desk.
NEXT_PUBLIC_QUOTE_ENDPOINT="https://script.google.com/macros/s/REPLACE_WITH_DEPLOYMENT_ID/exec"
